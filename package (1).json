{
  "name": "afk-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Oyun hesabi icin AFK botu (Capacitor + nodejs-mobile)",
  "scripts": {
    "node:kur": "cd static/nodejs && npm install --omit=dev",
    "node:hazirla": "node scripts/node-hazirla.mjs",
    "web": "vite build",
    "hazirla": "npm run node:hazirla && npm run web",
    "android:ekle": "cap add android && node scripts/android-kur.mjs",
    "senkron": "npm run hazirla && cap sync android",
    "apk": "npm run senkron && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "capacitor-nodejs": "https://github.com/hampoelz/capacitor-nodejs/releases/download/v1.0.0-beta.10/capacitor-nodejs.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "javascript-obfuscator": "latest",
    "vite": "latest"
  }
}
